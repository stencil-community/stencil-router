{
  "name": "@stencil-community/router",
  "version": "2.0.0-2",
  "description": "A tiny, treeshakable router for Stencil, built on @stencil/store",
  "keywords": [
    "router",
    "stencil",
    "store"
  ],
  "homepage": "https://github.com/stencil-community/stencil-router#readme",
  "license": "MIT",
  "author": "Manu Mtz.-Almeida",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stencil-community/stencil-router.git",
    "directory": "packages/router"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@stencil/store": "^2.2.4"
  },
  "devDependencies": {
    "@stencil/core": "^4.45.2",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@stencil/core": "^4.0.0 || ^5.0.0-0"
  }
}
