{
  "compilerOptions": {
    "strict": true,
    "allowUnreachableCode": false,
    "declaration": true,
    "isolatedModules": true,
    "lib": ["dom", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src"]
}
